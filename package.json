{
  "name": "partrunner-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Shared PartRunner packages for UI, navigation, cross-app sessions, and backend primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Partrunner-ai/partrunner-platform.git"
  },
  "homepage": "https://github.com/Partrunner-ai/partrunner-platform#readme",
  "bugs": {
    "url": "https://github.com/Partrunner-ai/partrunner-platform/issues"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "NODE_OPTIONS=--no-experimental-webstorage turbo run test",
    "pretest:browser": "pnpm build",
    "test:browser": "playwright test -c playwright-ct.config.ts",
    "preview:components": "pnpm --filter @partrunner-ai/showcase dev",
    "preview:tests": "playwright test -c playwright-ct.config.ts --ui",
    "typecheck": "turbo run typecheck",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"scripts/*.mjs\" --max-warnings 0",
    "release:plan": "node scripts/release-plan.mjs",
    "release:config:test": "node --test scripts/changeset-changelog.test.mjs scripts/prepare-bootstrap-artifacts.test.mjs scripts/public-release-config.test.mjs scripts/publish-verified-artifacts.test.mjs scripts/release-plan.test.mjs",
    "bootstrap:artifacts": "node scripts/prepare-bootstrap-artifacts.mjs",
    "packages:check": "pnpm run release:config:test && node scripts/verify-package-artifacts.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "release": "node scripts/publish-verified-artifacts.mjs .artifacts/release",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "tsup": "^8.5.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
