{
  "name": "@partrunner-ai/tokens",
  "version": "2.0.1",
  "description": "PartRunner design tokens - Crystal v2 semantic CSS variables, themes, and self-hosted brand fonts, with nexus retained as a deprecated compatibility export",
  "license": "(MIT AND OFL-1.1)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nexus.css": "./styles/nexus.css",
    "./nexus-light.css": "./styles/nexus-light.css",
    "./fonts.css": "./styles/fonts.css",
    "./crystal.css": "./styles/crystal.css",
    "./crystal-light.css": "./styles/crystal-light.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./nexus-channels.css": "./styles/nexus-channels.css",
    "./crystal-channels.css": "./styles/crystal-channels.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsx src/emit.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist styles .turbo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Partrunner-ai/partrunner-platform.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Partrunner-ai/partrunner-platform/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/Partrunner-ai/partrunner-platform/issues"
  }
}
